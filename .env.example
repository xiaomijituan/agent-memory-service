# Copy to .env and fill in real values. Never commit .env.
# All settings use the AMC_ prefix; environment variables override this file.

AMC_SERVICE_NAME=agent-memory-service
AMC_VERSION=v1.4

# Authentication. "none" disables auth and is only intended for local development.
AMC_AUTH_SCHEME=token
AMC_MEMORY_SYSTEM_KEY=change-me

# Storage
AMC_DB_DIR=data
AMC_MAX_OPEN_DBS=32

# Admission control (per process; requires a single worker)
AMC_ADD_CONCURRENCY=8
AMC_SEARCH_CONCURRENCY=2
AMC_ADMISSION_WAIT_SECONDS=10
AMC_REQUEST_TIMEOUT_SECONDS=1800

# Embeddings. Set AMC_EMBEDDING_MODE=off to run lexical-only without a provider.
AMC_EMBEDDING_MODE=api
AMC_EMBEDDING_PROVIDER=api
AMC_EMBEDDING_BASE_URL=https://your-provider.example/v1
AMC_EMBEDDING_MODEL=your-embedding-model
AMC_EMBEDDING_API_KEY=your-embedding-api-key
AMC_EMBEDDING_DIMENSIONS=1024
AMC_EMBEDDING_BATCH_SIZE=10

# Optional request-shape telemetry. Leave off unless you are debugging a caller.
AMC_SHAPE_PROBE=off

# Retrieval and chunking
AMC_FUSION_WEIGHT_LEXICAL=1.0
AMC_FUSION_WEIGHT_VECTOR=1.0
AMC_CHUNK_WINDOW_WORDS=320
AMC_CHUNK_OVERLAP_WORDS=40
AMC_CHUNK_STRIDE_WORDS=280
